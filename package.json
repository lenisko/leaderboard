{
  "name": "pogo-leaderboard",
  "version": "7.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run i18n:compile && npm run build:server && npm run build:next",
    "build-storybook": "storybook build",
    "build:next": "next build",
    "build:server": "tsc --project tsconfig.server.json",
    "postbuild:server": "fix-esm-import-path dist/server/index.js",
    "chromatic": "chromatic --exit-zero-on-changes",
    "commit": "git-cz",
    "dev": "cross-env NODE_ENV=development PORT=4000 NEXTAUTH_URL=http://localhost:4000 next dev",
    "dev:cron": "cross-env NODE_ENV=development tsx --tsconfig tsconfig.server.json server/index.ts",
    "i18n:compile": "formatjs compile-folder --ast src/i18n/lang src/i18n/compiled-lang",
    "i18n:extract": "formatjs extract --ignore 'src/**/*.d.ts' --id-interpolation-pattern '[sha512:contenthash:base64:6]' --out-file src/i18n/lang/en.json 'src/**/*.{js,ts,tsx}'",
    "i18n:sync": "tsx server/synchroniseTranslationFile.cts",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "lint:fix": "npm run lint -- --fix",
    "postbuild:next2": "cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "postinstall": "node-config-ts",
    "prebuild": "node-config-ts && npm run schema:create",
    "prepare": "husky || true",
    "prettier": "prettier --write --ignore-unknown 'src/**/*'",
    "schema:create": "tsx --tsconfig tsconfig.server.json server/create-schema.ts",
    "schema:migrate": "tsx --tsconfig tsconfig.server.json server/migrate-schema-to-golbat.ts",
    "start": "concurrently --kill-others --names next,back \"node dist/server/start-next.js\" \"node dist/server/index.js\"",
    "storybook": "storybook dev -p 7349 -h localhost"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "arrowParens": "always"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.gitTag} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ],
    "preset": "angular"
  },
  "engines": {
    "node": ">= 18",
    "npm": ">= 9"
  },
  "volta": {
    "node": "22.22.0"
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.9",
    "@ag-grid-community/core": "^32.3.9",
    "@ag-grid-community/react": "^32.3.9",
    "@headlessui/react": "^2.2.10",
    "@next-auth/sequelize-adapter": "^1.0.8",
    "@formatjs/cli": "^6.14.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cron": "^4.4.0",
    "discord-api-types": "^0.38.47",
    "mysql2": "^3.22.2",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "node-config-ts": "3.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intl": "^10.1.2",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5",
    "swr": "^2.4.1",
    "fix-esm-import-path": "^1.10.3",
    "tslog": "^4.10.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@mdx-js/preact": "^3.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "chromatic": "^16.6.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.7",
    "cz-conventional-commit": "^1.0.6",
    "eslint": "9.27.0",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^6.4.5",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "sequelize-cli": "^6.6.5",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "vite-plugin-environment": "^1.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "webpack-stats-plugin": "^1.1.3"
  }
}
